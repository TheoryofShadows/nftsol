# NFTSol Frontend Local Development
# Copy this to .env and fill in your values
# Default configuration uses Solana MAINNET-BETA

VITE_API_BASE=http://localhost:3001
VITE_IMG_PROXY_BASE=http://localhost:3001

# Solana - MAINNET-BETA by default (PRODUCTION)
# To use DEVNET for development/testing, change to:
#   VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
#   VITE_SOLANA_CLUSTER=devnet
#   VITE_WALLET_ADAPTER_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_WALLET_ADAPTER_NETWORK=mainnet-beta
VITE_WS_URL=ws://localhost:3001

# Sentry Error Tracking Configuration
VITE_SENTRY_DSN=https://your_sentry_dsn@o123456.ingest.sentry.io/123456
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACE_SAMPLE_RATE=1.0
VITE_SENTRY_SEND_PII=false
VITE_APP_VERSION=1.0.0
