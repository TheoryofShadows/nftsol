# Client Environment Variables Template
# Copy this file to env.production or env.development and fill in your actual values
# DO NOT commit files with actual secrets to git

# Environment
VITE_NODE_ENV=production
VITE_API_BASE=https://your-api-domain.onrender.com

# Solana Configuration
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_HELIUS_API_KEY=your_helius_api_key_here
VITE_HELIUS_REST_URL=https://api.helius.xyz/v0

# CLOUT Token Addresses
VITE_CLOUT_MINT=your_clout_mint_address
VITE_CLOUT_TREASURY=your_clout_treasury_address
VITE_CLOUT_DEVELOPER=your_clout_developer_address
VITE_CLOUT_FEE_COLLECTOR=your_clout_fee_collector_address

# IPFS/Pinata
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key

# Web3 Storage (optional)
VITE_WEB3_STORAGE_API_KEY=your_web3_storage_key

# WebSocket
VITE_WS_URL=wss://your-api-domain.onrender.com

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id
