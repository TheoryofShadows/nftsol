{
  "name": "nftsol-client",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --port 5173",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.cjs . --ext .ts,.tsx",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "type-check": "tsc --noEmit",
    "optimize": "npm run build && npm run type-check",
    "test:contracts": "echo 'Contract tests not yet configured' && exit 0"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.2.1",
    "@sentry/react": "^10.27.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.16.10",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/node": "^24.10.1",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-joyride": "^2.9.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "undici": "^7.10.0",
    "axios": "^1.9.0",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.10",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.10"
  }
}
