version: "3.9"
services:
  ipfs-proxy:
    image: nftsol/ipfs-proxy:latest
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "3002"
      LOG_LEVEL: info
      IPFS_PRIMARY_GATEWAY: https://w3s.link
      IPFS_FALLBACK_GATEWAYS: https://ipfs.io,https://cloudflare-ipfs.com,https://gateway.pinata.cloud
      IPFS_TIMEOUT_MS: "8000"
      IPFS_RETRIES: "2"
      IPFS_BACKOFF_MS: "300"
      DISK_CACHE_DIR: .ipfs-cache
      DISK_CACHE_MAX_MB: "500"
      MAX_IMAGE_MB: "50"
      RATE_LIMIT_PER_MIN: "300"
    ports:
      - "8080:3002"

  solana-worker:
    build:
      context: /home/khk89/NFTSol_step0/solana-worker
      dockerfile: Dockerfile
    image: nftsol/solana-worker:latest
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "8090"
      RPC_URL: "${RPC_URL:-https://api.devnet.solana.com}"
      COMMITMENT: "confirmed"
      WALLET_KEYPAIR_PATH: "/secrets/wallet.json"
      # MARKETPLACE_PROGRAM_ID: "11111111111111111111111111111111"
    volumes:
      - /home/khk89/NFTSol_step0/secrets:/secrets:ro
    ports:
      - "8090:8090"
