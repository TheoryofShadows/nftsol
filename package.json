{
  "name": "nftsol-root",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "install:all": "npm ci --ignore-scripts && cd client && npm ci --ignore-scripts && cd ../apps/backend && npm ci --ignore-scripts && cd ../..",
    "build": "cd apps/backend && (npm ci || npm install) && npm run build && cd ../../client && (npm ci || npm install) && npm run build",
    "build:backend": "cd apps/backend && (npm ci || npm install) && npm run build",
    "start": "cd apps/backend && npm start",
    "start:prod": "cd apps/backend && npm run start:prod",
    "dev": "cd apps/backend && npm run dev",
    "test": "cd apps/backend && npm test",
    "test:watch": "cd apps/backend && npm run test:watch",
    "test:coverage": "cd apps/backend && npm run test:coverage",
    "lint": "npm run lint:root && npm run lint:client && npm run lint:backend",
    "lint:root": "echo \"Linting root files...\"",
    "lint:client": "cd client && npm run lint",
    "lint:backend": "cd apps/backend && npm run lint",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "scan:secrets": "node scripts/scan-secrets.js",
    "audit": "cd apps/backend && npm audit",
    "audit:fix": "cd apps/backend && npm audit fix",
    "snyk-test": "cd apps/backend && npx snyk test",
    "snyk-monitor": "cd apps/backend && npx snyk monitor",
    "check-vulnerabilities": "cd apps/backend && npm run check-vulnerabilities",
    "check-dependencies": "cd apps/backend && npm run check-dependencies",
    "check-licenses": "cd apps/backend && npm run check-licenses"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.4",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "*/*.{js,ts,tsx,json,md,css,scss}": [
      "prettier -w"
    ],
    "{client,apps/backend}/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bcryptjs": "^3.0.3",
    "bs58": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "pg": "^8.22.0"
  }
}
