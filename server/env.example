# NFTSol Environment Configuration Template
# Copy this file to .env.development and fill in your actual values
# NEVER commit .env files with real secrets to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate a strong JWT secret (minimum 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long

# Generate a strong session secret (minimum 32 characters)
# Use: openssl rand -base64 32
SESSION_SECRET=your-super-secure-session-secret-minimum-32-characters-long

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/nftsol_dev

# Redis connection string (optional)
REDIS_URL=redis://localhost:6379

# =============================================================================
# PINATA IPFS CONFIGURATION
# =============================================================================
# Get these from https://pinata.cloud -> API Keys
PINATA_API_KEY=your-pinata-api-key-here
PINATA_SECRET_KEY=your-pinata-secret-key-here
PINATA_JWT=your-pinata-jwt-token-here

# =============================================================================
# HELIUS SOLANA CONFIGURATION
# =============================================================================
# Get this from https://helius.xyz -> Get API Key
HELIUS_API_KEY=your-helius-api-key-here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key-here
HELIUS_REST_URL=https://api.helius.xyz/v0

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Development origins (comma-separated)
DEV_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Production origins (comma-separated)
ALLOWED_ORIGINS=https://nftsol.app,https://www.nftsol.app,https://market.nftsol.app

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# AWS S3 CONFIGURATION (Optional)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BACKUP_BUCKET=your-backup-bucket
S3_BACKUP_REGION=us-east-1

# =============================================================================
# OPENAI CONFIGURATION (Optional)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# Comma-separated list of admin IP addresses
ADMIN_IPS=127.0.0.1,::1

# =============================================================================
# CLOUT TOKEN CONFIGURATION
# =============================================================================
CLOUT_MINT=your-clout-mint-address
CLOUT_TREASURY=your-clout-treasury-address
CLOUT_FEE_COLLECTOR=your-clout-fee-collector-address
CLOUT_DEVELOPER=your-clout-developer-address

# =============================================================================
# SECURITY HEADERS
# =============================================================================
HELMET_CSP_ENABLED=true
TRUST_PROXY=1
