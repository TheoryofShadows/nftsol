{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "src/ipfs-img-proxy.ts",
    "src/ipfsProxyStandalone.ts",
    "src/ipfs*",
    "src/**/ipfs*",
    "src/**/*ipfs*",
    "src/**/ipfsProxy*",
    "src/**/ipfs-img-proxy*",
    "src/**/ipfsProxyStandalone*"
  ]
}