{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "src/ipfs-img-proxy.ts",
    "src/ipfsProxyStandalone.ts"
  ]
}