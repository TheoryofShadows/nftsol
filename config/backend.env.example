# Server Environment Variables Template
# Copy this file to env.production or env.development and fill in your actual values
# DO NOT commit files with actual secrets to git

# Server Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://username:password@host:port/database

# Solana Configuration
SOLANA_CLUSTER=mainnet-beta
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_REST_URL=https://api.helius.xyz/v0
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_TIMEOUT_MS=15000

# Security
JWT_SECRET=your_jwt_secret_here_min_32_chars
SESSION_SECRET=your_session_secret_here_min_32_chars
WEBHOOK_SECRET=your_webhook_secret_here

# CORS
ALLOWED_ORIGINS=https://nftsol.app
DEV_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CLOUT Token Addresses
CLOUT_MINT=your_clout_mint_address
CLOUT_TREASURY=your_clout_treasury_address
CLOUT_FEE_COLLECTOR=your_clout_fee_collector_address
CLOUT_DEVELOPER=your_clout_developer_address

# IPFS/Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Web3 Storage (optional)
WEB3_STORAGE_API_KEY=your_web3_storage_key

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Helmet Security
HELMET_CSP_ENABLED=true
TRUST_PROXY=1

# IPFS Proxy
IPFS_PROXY_PORT=3003
