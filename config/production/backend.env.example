# Production Environment Variables Template
# Copy this to .env.production and fill in your actual values

NODE_ENV=production
PORT=3000

# Database (Production PostgreSQL)
DATABASE_URL=postgresql://username:password@your-production-db-host:5432/nftsol_prod

# Redis (Production)
REDIS_URL=redis://your-production-redis-host:6379

# API Keys (Production)
PINATA_API_KEY=your-production-pinata-key
PINATA_SECRET_KEY=your-production-pinata-secret
HELIUS_API_KEY=your-production-helius-key

# Security (Production - Generate new secrets)
JWT_SECRET=your-production-jwt-secret-64-chars-minimum
SESSION_SECRET=your-production-session-secret-64-chars-minimum

# CORS (Production)
ALLOWED_ORIGINS=https://nftsol.app,https://www.nftsol.app,https://market.nftsol.app

# CLOUT Token (Production)
CLOUT_MINT=your-production-clout-mint-address
CLOUT_TREASURY=your-production-clout-treasury-address
CLOUT_FEE_COLLECTOR=your-production-clout-fee-collector-address
CLOUT_DEVELOPER=your-production-clout-developer-address

# OpenAI (Optional)
OPENAI_API_KEY=your-production-openai-key
