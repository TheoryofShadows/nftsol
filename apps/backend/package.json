{
  "name": "nftsol-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect npm run dev",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint . --ext .ts,.tsx --config .eslintrc.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --config .eslintrc.cjs",
    "build": "npm run clean && tsc -p tsconfig.build.json --ignoreDeprecations 5.0 && npm run copy:assets",
    "build:prod": "NODE_ENV=production npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "copy:assets": "node scripts/copy-assets.cjs",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "smoketest:mint": "tsx scripts/devnet-mint-smoketest.ts",
    "setup:tree": "tsx scripts/createTree.ts",
    "mint:doctor": "tsx scripts/mint-doctor.ts",
    "test": "jest --coverage --config jest.config.js",
    "test:watch": "npm test -- --watch",
    "test:unit": "npm test -- --testPathPattern=src/.*\\.spec\\.ts$",
    "test:integration": "npm test -- --testPathPattern=src/.*\\.int\\.ts$",
    "test:e2e": "npm test -- --testPathPattern=src/.*\\.e2e\\.ts$",
    "test:coverage": "npm test -- --coverage",
    "test:security": "npm audit --production",
    "test:types": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "snyk-test": "snyk test",
    "snyk-monitor": "snyk monitor",
    "check-vulnerabilities": "npm audit --production && snyk test",
    "check-dependencies": "depcheck",
    "check-licenses": "license-checker --production --onlyAllow='MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0'",
    "db:migrate:test": "echo 'No test DB migration needed in CI' && exit 0",
    "test:pact:verify": "echo 'Pact verification not yet configured' && exit 0"
  },
