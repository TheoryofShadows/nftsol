# NFTSol Backend Environment Variables

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nftsol

# ============================================
# Redis Configuration (Optional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Session & Security
# ============================================
SESSION_SECRET=your-super-secret-session-key-change-this
NODE_ENV=development

# ============================================
# Solana Configuration
# ============================================
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
WALLET_PRIVATE_KEY=your-base58-private-key

# ============================================
# xAI Grok API (Eternal Echoes)
# ============================================
# Get API key from: https://x.ai/api
XAI_API_KEY=xai-your-api-key-here
XAI_API_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta
XAI_MAX_TOKENS=500
XAI_TEMPERATURE=0.3

# ============================================
# IPFS / Irys Storage
# ============================================
IRYS_NETWORK=devnet
IRYS_TOKEN=solana
IRYS_RPC_URL=https://api.devnet.solana.com

# ============================================
# AWS S3 (Optional for backups)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
S3_BACKUP_BUCKET=nftsol-backups
S3_BACKUP_REGION=us-east-1

# ============================================
# WebSocket Configuration
# ============================================
WS_ENABLED=true
WS_PORT=3002

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn (optional)
