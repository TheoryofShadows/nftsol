# NFTSol Backend Server Configuration
# Copy this to .env and fill in your values
# Default configuration uses Solana MAINNET-BETA

# Server
NODE_ENV=development
PORT=3001

# Database - Local PostgreSQL for development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nftsol"

# JWT
JWT_SECRET="your_jwt_secret_minimum_32_characters"
SESSION_SECRET="your_session_secret_here"

# Solana - MAINNET-BETA by default (PRODUCTION)
# To use DEVNET for development/testing, change to:
#   SOLANA_RPC_URL="https://api.devnet.solana.com"
#   CLUSTER="devnet"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
CLUSTER="mainnet-beta"
CLOUT_MINT="26iJ37BE3icVtoo2QRkfjtYXFHMudG2sbTHAnhF2D6ab"
CLOUT_PROGRAM_ID="26iJ37BE3icVtoo2QRkfjtYXFHMudG2sbTHAnhF2D6ab"
REWARDS_OWNER="3XEs3MJ8PFiqTTqrK6RAkK9vt95jQQ1hKNNKHiE6jJ3o"

# Platform
PLATFORM_SECRET_KEY_BASE58="your_platform_secret_key_here"
PLATFORM_KEYPAIR=""

# ============================================
# Platform Wallet Configuration
# ============================================
# Developer Wallet - Receives 1% of all marketplace sales for operations & development
DEVELOPER_WALLET_PUBLIC_KEY="your_developer_wallet_address_here"

# CLOUT Treasury Wallet - Community rewards and token distribution
# CLOUT_TREASURY_WALLET="your_clout_treasury_address"

# Marketplace Treasury Wallet - Operational reserves and contingency fund
# MARKETPLACE_TREASURY_WALLET="your_marketplace_treasury_address"

# Creator Escrow Wallet - Temporary holding for creator royalty payouts
# CREATOR_ESCROW_WALLET="your_creator_escrow_address"

# Optional (set these if needed)
HELIUS_API_KEY="your_helius_api_key"
# PINATA_JWT=""
# PINATA_SECRET_KEY=""
# IRYS_WALLET_PRIVATE_KEY=""
# BUBBLEGUM_TREE_ADDRESS=""

# ============================================
# Sentry Error Tracking Configuration
# ============================================
SENTRY_DSN=https://your_sentry_dsn@o123456.ingest.sentry.io/123456
SENTRY_ENVIRONMENT=development
SENTRY_SEND_PII=true
SENTRY_TRACE_SAMPLE_RATE=1.0
APP_VERSION=1.0.0
SERVER_NAME=nftsol-backend-dev
