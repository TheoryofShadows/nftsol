NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
SOLANA_CLUSTER=devnet

# Devnet RPC (no key required)
HELIUS_API_KEY=
HELIUS_RPC_URL=https://api.devnet.solana.com
HELIUS_REST_URL=https://api.helius.xyz/v0
HELIUS_TIMEOUT_MS=15000

# CORS
DEV_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001,http://127.0.0.1:5173

# Disable persistent stores in dev
DATABASE_URL=
REDIS_URL=

# App secrets (generate locally; do not commit real values)
SESSION_SECRET=
JWT_SECRET=
BCRYPT_ROUNDS=10

# Signers (never commit real keys)
BUBBLEGUM_PRIVATE_KEY=
IRYS_WALLET_PRIVATE_KEY=

# Features
WS_ENABLED=true
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads
ENABLE_MONITORING=true
LOG_REQUESTS=true

