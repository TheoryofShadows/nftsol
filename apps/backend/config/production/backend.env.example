NODE_ENV=production
PORT=8080
LOG_LEVEL=info
SOLANA_CLUSTER=mainnet-beta

# Helius (recommended for prod)
HELIUS_API_KEY=
# If you prefer explicit URL:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_REST_URL=https://api.helius.xyz/v0
HELIUS_TIMEOUT_MS=20000

# CORS (set to your domains)
DEV_ALLOWED_ORIGINS=https://your-domain.com

# Persistent stores (required in prod)
DATABASE_URL=postgresql://user:password@db:5432/nftsol
REDIS_URL=redis://redis:6379

# App secrets (required)
SESSION_SECRET=
JWT_SECRET=
BCRYPT_ROUNDS=12

# Signers (required in prod; use secure secret manager)
BUBBLEGUM_PRIVATE_KEY=
IRYS_WALLET_PRIVATE_KEY=

# Features
WS_ENABLED=true
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads
ENABLE_MONITORING=true
LOG_REQUESTS=true

