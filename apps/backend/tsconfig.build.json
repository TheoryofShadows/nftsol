{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "src/__tests__",
    "src/__mocks__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/app.ts",
    "src/config.ts",
    "src/app-production.ts",
    "src/server-production.ts"
  ]
}
