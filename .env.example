# NFTSol Platform Configuration Template
# Copy this file to .env and fill in your values
# Default configuration uses Solana MAINNET-BETA for production
# For development with devnet, see .env.devnet

# ===========================================
# CRITICAL: Database Configuration
# ===========================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nftsol
DATABASE_URL_FALLBACK=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nftsol
PGPASSWORD=YOUR_PASSWORD

# ===========================================
# Environment Setup
# ===========================================
NODE_ENV=development
PORT=3001
SESSION_SECRET=change-this-in-production

# ===========================================
# Platform Wallet Keys (KEEP SECURE!)
# ===========================================
PLATFORM_PUBLIC_KEY=your_public_key_here
PLATFORM_SECRET_KEY_BASE58=your_secret_key_here
PLATFORM_SECRET_KEY_JSON=your_keypair_json_here

# ===========================================
# JWT & Security
# ===========================================
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_EXPIRY=86400
ADMIN_WALLETS=your_admin_wallet_address

# ===========================================
# Solana Configuration (MAINNET-BETA - PRODUCTION)
# ===========================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Optional: RPC Endpoints for High Availability
HELIUS_API_KEY=your_helius_api_key_here
QUICKNODE_RPC_URL=https://your-quicknode-endpoint

# For development with devnet, copy settings from .env.devnet file

# ===========================================
# Program IDs (Solana Programs)
# ===========================================
CLOUT_PROGRAM_ID=26iJ37BE3icVtoo2QRkfjtYXFHMudG2sbTHAnhF2D6ab
CLOUT_MINT=26iJ37BE3icVtoo2QRkfjtYXFHMudG2sbTHAnhF2D6ab
MARKET_PROGRAM_ID=HTs1hErzM8MywaUojfUY7QA1T6gLQD977R3HsCnKj7m7
LOYALTY_PROGRAM_ID=2TujfT3Czd2ncawJ6ZLmfGeJ2t1Ugb9bqEvxSE2EKoo9
REWARDS_OWNER=3XEs3MJ8PFiqTTqrK6RAkK9vt95jQQ1hKNNKHiE6jJ3o
REWARDS_VAULT=7SBYHw5KQasPKajH6gCDnpWmb5QAh9EBvTi3cUnFAc1v

# ===========================================
# Compressed NFT Configuration (Optional)
# ===========================================
MERKLE_TREE_ADDRESS=your_merkle_tree_address
MERKLE_TREE_CACHE_PATH=./data/merkle-tree.json
BUBBLEGUM_TREE_ADDRESS=your_bubblegum_tree_address

# ===========================================
# Tensor Marketplace Integration (Optional)
# ===========================================
# API key for live Tensor orderbook/collection data.
TENSOR_API_KEY=your_tensor_api_key_here
# When the live Tensor API is unavailable, the orderbook endpoint returns 404 by
# default. Set this to "true" ONLY for local demos to serve synthetic (random)
# orderbook data instead — never enable in production, the numbers are not real.
TENSOR_ALLOW_MOCK=false

# ===========================================
# CORS Configuration
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# ===========================================
# File Upload & Storage
# ===========================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# AWS S3 (Optional - for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name

# ===========================================
# IPFS & Metadata Upload (Optional)
# ===========================================
PINATA_JWT=your_pinata_jwt_token
PINATA_SECRET_KEY=your_pinata_secret_key
IRYS_UPLOAD_DISABLED=true
IRYS_NODE_URL=https://node1.irys.xyz
IRYS_PROVIDER_URL=https://api.mainnet-beta.solana.com
IRYS_WALLET_PRIVATE_KEY=your_irys_wallet_key
IRYS_TIMEOUT_MS=30000

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=2000
WITHDRAWAL_RATE_LIMIT_WINDOW_MS=900000
WITHDRAWAL_RATE_LIMIT_MAX=5

# ===========================================
# Withdrawal Configuration
# ===========================================
MAX_SINGLE_WITHDRAWAL_LAMPORTS=10000000000
MAX_DAILY_PER_USER_LAMPORTS=50000000000
WITHDRAWAL_AUTO_APPROVE_LAMPORTS=100000000
WITHDRAWAL_DAILY_LIMIT_LAMPORTS=5000000000

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ===========================================
# Email Service (Optional)
# ===========================================
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@nftsol.app

# ===========================================
# Redis (Optional - for production)
# ===========================================
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===========================================
# Feature Flags
# ===========================================
ENABLE_COMPRESSED_NFTS=true
ENABLE_GROK_VERIFICATION=true
ENABLE_ECHO_FEATURE=true

# ===========================================
# Sentry Error Tracking Configuration
# ===========================================
SENTRY_DSN=https://your_sentry_dsn@o123456.ingest.sentry.io/123456
SENTRY_ENVIRONMENT=development
SENTRY_SEND_PII=false
SENTRY_TRACE_SAMPLE_RATE=1.0
APP_VERSION=1.0.0
SERVER_NAME=nftsol-backend-dev
