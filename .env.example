# Backend (Render)
NODE_ENV=production
PORT=3003
HELIUS_API_KEY=<set-in-render>
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
ALLOWED_ORIGINS=https://nftsol.app,https://www.nftsol.app,https://api.nftsol.app

# Frontend (Netlify)
NEXT_PUBLIC_API_BASE=https://api.nftsol.app
NEXT_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=<set-in-netlify-context>
