# Server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# IPFS
IPFS_PRIMARY_GATEWAY=https://w3s.link
IPFS_FALLBACK_GATEWAYS=https://ipfs.io,https://cloudflare-ipfs.com,https://gateway.pinata.cloud
IPFS_TIMEOUT_MS=8000
IPFS_RETRIES=2
IPFS_BACKOFF_MS=300

# Caching
REDIS_URL=redis://localhost:6379
DISK_CACHE_DIR=.ipfs-cache
DISK_CACHE_MAX_MB=500

# Security/limits
MAX_IMAGE_MB=20
RATE_LIMIT_PER_MIN=300

# Feature Flags (future)
FEATURE_MARKET_V1=false
FEATURE_SOLANA_READ=false
FEATURE_SOLANA_MINT=false
