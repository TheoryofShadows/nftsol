# ──────────────────────────────────────
# Eternal Echoes - Production Environment
# Copy to .env and fill in real values
# ──────────────────────────────────────

# ──────────────────────────────────────
# Core
NODE_ENV=production
PORT=3001

# ──────────────────────────────────────
# Database
DATABASE_URL=postgres://USER:PASS@HOST:5432/nftsol
POSTGRES_PRISMA_URL=${DATABASE_URL}

# ──────────────────────────────────────
# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
CLUSTER=mainnet-beta

# ──────────────────────────────────────
# xAI (Grok)
XAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────
# Merkle Tree (Bubblegum)
MERKLE_TREE_ADDRESS=Tree1111111111111111111111111111111111111111   # replace after createTree()

# ──────────────────────────────────────
# Irys (permanent storage)
IRYS_NODE=https://node1.irys.xyz
IRYS_TOKEN=solana

# ──────────────────────────────────────
# Redis (Socket.io adapter + cache)
REDIS_URL=redis://:PASS@HOST:6379

# ──────────────────────────────────────
# Security
JWT_SECRET=super-long-random-string-here
CORS_ORIGINS=https://nftsol.com,https://www.nftsol.com

# ──────────────────────────────────────
# Monitoring
SENTRY_DSN=https://xxxxx@o.yyy.ingest.sentry.io/zzzzz
