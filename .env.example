# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=https://nftsol.app,https://www.nftsol.app
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Solana / Helius
SOLANA_CLUSTER=mainnet-beta
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_REST_URL=https://api.helius.xyz/v0
HELIUS_TIMEOUT_MS=15000

# IPFS
IPFS_PRIMARY_GATEWAY=https://w3s.link
IPFS_FALLBACK_GATEWAYS=https://ipfs.io,https://cloudflare-ipfs.com,https://gateway.pinata.cloud
IPFS_TIMEOUT_MS=8000
IPFS_RETRIES=2
IPFS_BACKOFF_MS=300

# Caching
REDIS_URL=redis://localhost:6379
DISK_CACHE_DIR=.ipfs-cache
DISK_CACHE_MAX_MB=500

# Security/limits
MAX_IMAGE_MB=20
RATE_LIMIT_PER_MIN=300

# Feature Flags (future)
FEATURE_MARKET_V1=false
FEATURE_SOLANA_READ=false
FEATURE_SOLANA_MINT=false
